{
  "Ferdek Program": {
    "prefix": "ferdek",
    "body": [
      "CO JEST KURDE",
      "",
      "RYM CYM CYM ${1:Opis programu}",
      "${2:PANIE SENSACJA REWELACJA \"Cześć!\"}",
      "",
      "MOJA NOGA JUŻ TUTAJ NIE POSTANIE"
    ],
    "description": "Basic Ferdek program structure"
  },
  "Print Statement": {
    "prefix": "print",
    "body": "PANIE SENSACJA REWELACJA ${1:\"text\"}",
    "description": "Print to console"
  },
  "Variable Declaration": {
    "prefix": "var",
    "body": "CYCU PRZYNIEŚ NO ${1:zmienna}\nTO NIE SĄ TANIE RZECZY ${2:5}",
    "description": "Declare a variable"
  },
  "Array Declaration": {
    "prefix": "array",
    "body": "PANIE TO JEST PRYWATNA PUBLICZNA TABLICA ${1:tablica}\nTO NIE SĄ TANIE RZECZY [${2:1}, ${3:2}, ${4:3}]",
    "description": "Declare an array"
  },
  "If Statement": {
    "prefix": "if",
    "body": [
      "NO JAK NIE JAK TAK ${1:warunek}",
      "\t${2:RYM CYM CYM code here}",
      "DO CHAŁUPY ALE JUŻ"
    ],
    "description": "If conditional"
  },
  "If-Else Statement": {
    "prefix": "ifelse",
    "body": [
      "NO JAK NIE JAK TAK ${1:warunek}",
      "\t${2:RYM CYM CYM code here}",
      "A DUPA TAM",
      "\t${3:RYM CYM CYM else code here}",
      "DO CHAŁUPY ALE JUŻ"
    ],
    "description": "If-else conditional"
  },
  "While Loop": {
    "prefix": "while",
    "body": [
      "CHLUŚNIEM BO UŚNIEM ${1:warunek}",
      "\t${2:RYM CYM CYM code here}",
      "A ROBIĆ NI MA KOMU"
    ],
    "description": "While loop"
  },
  "Function Declaration": {
    "prefix": "func",
    "body": [
      "ALE WIE PAN JA ZASADNICZO ${1:nazwa}",
      "NA TAKIE TEMATY NIE ROZMAWIAM NA SUCHO ${2:param1}, ${3:param2}",
      "\t${4:RYM CYM CYM function body}",
      "\tI JA INFORMUJĘ ŻE WYCHODZĘ ${5:rezultat}",
      "DO WIDZENIA PANU"
    ],
    "description": "Function declaration"
  },
  "Function Call": {
    "prefix": "call",
    "body": "W MORDĘ JEŻA ${1:funkcja}(${2:arg1}, ${3:arg2})",
    "description": "Function call"
  },
  "Assign Function Result": {
    "prefix": "callassign",
    "body": "AFERA JEST ${1:zmienna} W MORDĘ JEŻA ${2:funkcja}(${3:arg1})",
    "description": "Assign function result to variable"
  },
  "String Concatenation": {
    "prefix": "concat",
    "body": "AFERA JEST ${1:tekst} W MORDĘ JEŻA USIĄDŹ NA KANAPIE(${2:\"str1\"}, ${3:\"str2\"})",
    "description": "Concatenate strings using KANAPA"
  },
  "String Length": {
    "prefix": "strlen",
    "body": "AFERA JEST ${1:dlugosc} W MORDĘ JEŻA ILE MIEJSCA NA KANAPIE(${2:\"text\"})",
    "description": "Get string length using KANAPA"
  },
  "Substring": {
    "prefix": "substr",
    "body": "AFERA JEST ${1:podciag} W MORDĘ JEŻA POTNIJ KANAPĘ(${2:\"text\"}, ${3:0}, ${4:5})",
    "description": "Get substring using KANAPA"
  },
  "File Open": {
    "prefix": "fopen",
    "body": "AFERA JEST ${1:uchwyt} W MORDĘ JEŻA OTWÓRZ KIBEL(${2:\"/path/to/file\"})",
    "description": "Open file for reading using KIBEL"
  },
  "File Open Write": {
    "prefix": "fopenw",
    "body": "AFERA JEST ${1:uchwyt} W MORDĘ JEŻA OTWÓRZ KIBEL DO ZAPISU(${2:\"/path/to/file\"})",
    "description": "Open file for writing using KIBEL"
  },
  "File Write": {
    "prefix": "fwrite",
    "body": "W MORDĘ JEŻA SPUŚĆ WODĘ(${1:uchwyt}, ${2:\"content\"})",
    "description": "Write to file using KIBEL"
  },
  "File Read": {
    "prefix": "fread",
    "body": "AFERA JEST ${1:zawartość} W MORDĘ JEŻA WYPOMPUJ(${2:uchwyt})",
    "description": "Read from file using KIBEL"
  },
  "File Close": {
    "prefix": "fclose",
    "body": "W MORDĘ JEŻA ZAMKNIJ KIBEL(${1:uchwyt})",
    "description": "Close file using KIBEL"
  },
  "Try Catch": {
    "prefix": "try",
    "body": [
      "HELENA MUSZĘ CI COŚ POWIEDZIEĆ",
      "\t${1:RYM CYM CYM try block}",
      "HELENA MAM ZAWAŁ ${2:error}",
      "\t${3:RYM CYM CYM catch block}"
    ],
    "description": "Try-catch error handling"
  },
  "Throw Exception": {
    "prefix": "throw",
    "body": "O KARWASZ TWARZ ${1:\"error message\"}",
    "description": "Throw an exception"
  },
  "Import Module": {
    "prefix": "import",
    "body": "O KOGO MOJE PIĘKNE OCZY WIDZĄ ${1:KLAMOTY/KANAPA}",
    "description": "Import a module"
  },
  "Break": {
    "prefix": "break",
    "body": "A POCAŁUJCIE MNIE WSZYSCY W DUPĘ",
    "description": "Break from loop"
  },
  "Continue": {
    "prefix": "continue",
    "body": "AKUKARACZA",
    "description": "Continue loop iteration"
  },
  "Return Statement": {
    "prefix": "return",
    "body": "I JA INFORMUJĘ ŻE WYCHODZĘ ${1:wartość}",
    "description": "Return from function"
  }
}
